#: healthcare/setup.py:1580
msgid "The observation has been withdrawn following previous final release. This electronic record should never have existed, though it is possible that real-world decisions were based on it. (If real-world activity has occurred, the status should be 'cancelled' rather than 'entered-in-error'.)."
msgstr "Quan sát lâm sàng đã bị rút lại sau khi đã phát hành cuối cùng trước đó. Hồ sơ điện tử này không bao giờ nên tồn tại, mặc dù có khả năng các quyết định trong thực tế đã dựa trên nó. (Nếu hoạt động thực tế đã xảy ra, trạng thái nên là 'đã hủy' thay vì 'nhập sai')."

#: healthcare/setup.py:1538
msgid "The observation is complete and there are no further actions needed.)"
msgstr "Quan sát lâm sàng đã hoàn tất và không cần thực hiện thêm hành động nào."

#: healthcare/setup.py:1569
msgid "The observation is unavailable because the measurement was not started or not completed (also sometimes called 'aborted')."
msgstr "Quan sát lâm sàng không khả dụng vì việc đo lường chưa được bắt đầu hoặc chưa hoàn tất (đôi khi cũng được gọi là 'bị hủy')."

#: healthcare/setup.py:1667
msgid "The request (and any implicit authorization to act) has been temporarily withdrawn but is expected to resume in the future."
msgstr "Yêu cầu (và bất kỳ sự ủy quyền ngầm nào để hành động) đã tạm thời bị rút lại nhưng dự kiến sẽ tiếp tục trong tương lai."

#: healthcare/setup.py:1677
msgid "The request (and any implicit authorization to act) has been terminated prior to the known full completion of the intended actions. No further activity should occur."
msgstr "Yêu cầu (và bất kỳ quyền ủy quyền ngầm nào để hành động) đã bị chấm dứt trước khi hoàn tất toàn bộ các hành động dự định được biết đến. Không nên có bất kỳ hoạt động nào tiếp theo."

#: healthcare/setup.py:1651
msgid "The request has been created but is not yet complete or ready for action."
msgstr "Yêu cầu đã được tạo nhưng chưa hoàn tất hoặc sẵn sàng để thực hiện."

#: healthcare/setup.py:1770
msgid "The request has been withdrawn before any administrations have occurred"
msgstr "Yêu cầu đã được rút lại trước khi bất kỳ cơ quan quản lý nào tiến hành"

#: healthcare/setup.py:1037
msgid "The request has normal priority."
msgstr "Yêu cầu có mức ưu tiên bình thường."

#: healthcare/setup.py:1722
msgid "The request is 'actionable', but not all actions that are implied by it have occurred yet."
msgstr "Yêu cầu này là 'có thể thực hiện được', nhưng không phải tất cả các hành động được ngụ ý bởi nó đã xảy ra."

#: healthcare/setup.py:967
msgid "The request is a suggestion made by someone/something that does not have an intention to ensure it occurs and without providing an authorization to act."
msgstr "Yêu cầu là một gợi ý được đưa ra bởi ai đó/cái gì đó không có ý định đảm bảo nó xảy ra và không cung cấp quyền để hành động."

#: healthcare/setup.py:1659
msgid "The request is in force and ready to be acted upon."
msgstr "Yêu cầu đang có hiệu lực và sẵn sàng để được thực hiện."

#: healthcare/setup.py:1742
msgid "The request is no longer active and the subject should no longer be taking the medication."
msgstr "Yêu cầu này không còn hiệu lực và đối tượng không nên tiếp tục sử dụng thuốc."

#: healthcare/setup.py:1788
msgid "The request is not yet 'actionable', e.g. it is a work in progress, requires sign-off, verification or needs to be run through decision support process."
msgstr "Yêu cầu này chưa 'khả thi để hành động', ví dụ: nó đang được tiến hành, cần được phê duyệt, xác minh hoặc cần được đưa qua quy trình hỗ trợ quyết định."

#: healthcare/setup.py:1028
msgid "The request represents a component or option for a RequestOrchestration that establishes timing, conditionality and/or other constraints among a set of requests."
msgstr "Yêu cầu đại diện cho một thành phần hoặc tùy chọn cho một RequestOrchestration thiết lập thời gian, điều kiện và/hoặc các ràng buộc khác giữa một tập hợp các yêu cầu."

#: healthcare/setup.py:985
msgid "The request represents a legally binding instruction authored by a Patient or RelatedPerson."
msgstr "Yêu cầu này đại diện cho một chỉ dẫn có hiệu lực pháp lý được soạn bởi Bệnh nhân hoặc Người có liên quan."

#: healthcare/setup.py:958
msgid "The request represents a request/demand and authorization for action by the requestor."
msgstr "Yêu cầu này đại diện cho một yêu cầu/đòi hỏi và sự ủy quyền cho hành động bởi người yêu cầu."

#: healthcare/setup.py:1001
msgid "The request represents an automatically generated supplemental authorization for action based on a parent authorization together with initial results of the action taken against that parent authorization."
msgstr "Yêu cầu này đại diện cho một sự ủy quyền bổ sung được tạo tự động để thực hiện hành động dựa trên sự ủy quyền gốc cùng với kết quả ban đầu của hành động đã thực hiện đối với sự ủy quyền gốc đó."

#: healthcare/setup.py:976
msgid "The request represents an intention to ensure something occurs without providing an authorization for others to act."
msgstr "Yêu cầu này thể hiện ý định đảm bảo điều gì đó xảy ra mà không cung cấp quyền cho người khác hành động."

#: healthcare/setup.py:994
msgid "The request represents an original authorization for action."
msgstr "Yêu cầu này đại diện cho một ủy quyền gốc để thực hiện hành động."

#: healthcare/setup.py:1010
msgid "The request represents the view of an authorization instantiated by a fulfilling system representing the details of the fulfiller's intention to act upon a submitted order."
msgstr "Yêu cầu đại diện cho quan điểm của một sự ủy quyền được khởi tạo bởi một hệ thống thực hiện, đại diện cho các chi tiết về ý định của người thực hiện trong việc thực hiện một đơn đặt hàng đã được gửi."

#: healthcare/setup.py:1051
msgid "The request should be actioned as soon as possible - higher priority than urgent."
msgstr "Yêu cầu nên được thực hiện càng sớm càng tốt - ưu tiên cao hơn khẩn cấp."

#: healthcare/setup.py:1060
msgid "The request should be actioned immediately - highest possible priority. E.g. an emergency."
msgstr "Yêu cầu này nên được thực hiện ngay lập tức - ưu tiên cao nhất có thể. Ví dụ: một trường hợp khẩn cấp."

#: healthcare/setup.py:1044
msgid "The request should be actioned promptly - higher priority than routine."
msgstr "Yêu cầu nên được thực hiện ngay lập tức - ưu tiên cao hơn so với công việc thường nhật."

#: healthcare/setup.py:1778
msgid "The request was recorded against the wrong patient or for some reason should not have been recorded (e.g. wrong medication, wrong dose, etc.). Some of the actions that are implied by the medication request may have occurred. For example, the medication may have been dispensed and the patient may have taken some of the medication."
msgstr "Yêu cầu đã được ghi nhận nhầm cho bệnh nhân khác hoặc vì lý do nào đó không nên ghi nhận (ví dụ: thuốc sai, liều lượng sai, v.v.). Một số hành động được ngụ ý bởi yêu cầu thuốc có thể đã xảy ra. Ví dụ, thuốc có thể đã được phân phát và bệnh nhân có thể đã dùng một phần thuốc."

#: healthcare/setup.py:1450
msgid "The results of observations generated by laboratories. Laboratory results are typically generated by laboratories providing analytic services in areas such as chemistry, hematology, serology, histology, cytology, anatomic pathology (including digital pathology), microbiology, and/or virology. These observations are based on analysis of specimens obtained from the patient and submitted to the laboratory."
msgstr "Kết quả của các quan sát lâm sàng được tạo ra bởi các phòng thí nghiệm. Kết quả phòng thí nghiệm thường được tạo ra bởi các phòng thí nghiệm cung cấp dịch vụ phân tích trong các lĩnh vực như hóa học, huyết học, huyết thanh học, giải phẫu mô học, tế bào học, bệnh học giải phẫu (bao gồm cả bệnh học kỹ thuật số), vi sinh học và/hoặc vi rút học. Những quan sát lâm sàng này dựa trên phân tích các mẫu vật lấy từ bệnh nhân và được gửi đến phòng thí nghiệm."

